# Copy to .env.local and fill in. Never commit real values.

# Public site
# Canonical public origin, no trailing slash. Defaults to the production
# domain; override for staging so sitemaps do not advertise the live host.
NEXT_PUBLIC_SITE_URL=https://zeenthecyber.online

# ---------------------------------------------------------------------------
# Signal Desk (internal threat-intelligence console at /signal-desk)
# ---------------------------------------------------------------------------
# The desk is OFF unless SIGNAL_DESK_ENABLED is exactly "true". While it is off
# the route returns 404, so it is indistinguishable from a route that was never
# deployed. Enabling it without credentials fails closed with a 403.
#
# Leave SIGNAL_DESK_ENABLED unset in any public/preview environment.
SIGNAL_DESK_ENABLED=false
SIGNAL_DESK_USER=
SIGNAL_DESK_PASSWORD=

# Optional. Comma-separated IPs or CIDR ranges (IPv4 and IPv6) permitted to
# reach the desk, checked before credentials. Omit to allow any source address
# that can present valid credentials.
# SIGNAL_DESK_ALLOWED_IPS=203.0.113.0/24,10.8.0.5

# ---------------------------------------------------------------------------
# Intelligence feeds
# ---------------------------------------------------------------------------
# All upstream feeds (CISA KEV, NIST NVD, FIRST EPSS) are public and keyless.
# A GitHub token is optional and only raises the open-source stack telemetry
# rate limit from 60 to 5,000 requests/hour. A read-only, no-scope token is
# sufficient.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
ADMIN_EMAIL=

# SMTP fallback, used when RESEND_API_KEY is absent
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Upstash rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google AI / Genkit
GEMINI_API_KEY=
